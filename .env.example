# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1

DATABASE_PATH=database/medicore.db

# Set to 1 only behind HTTPS in production.
SESSION_COOKIE_SECURE=0

# Security lab toggle — keep enabled only on an isolated local/lab network.
# When 0, both vulnerable blueprints are never registered.
SECURITY_LAB_ENABLED=1
