# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file with secrets to GitHub.

# Generate a strong key for production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-secret-key
FLASK_DEBUG=0

DATABASE_PATH=database/medicore.db

# Set to 1 only behind HTTPS in production.
SESSION_COOKIE_SECURE=0

# Security lab toggle — disabled by default (0).
# Enable (1) ONLY for local educational penetration testing practice on 127.0.0.1.
# When 0, the vulnerable endpoints are never registered into the application.
SECURITY_LAB_ENABLED=0
